---
import '../styles/global.css'
import AppShell from "@/components/AppShell.astro";
import NoteEditor from "@/modules/NoteEditor";
import NotesList from "@/modules/NotesList";
---
---

<section
  class="
    w-full
    bg-zinc-100
    px-6
    py-6
    dark:bg-zinc-800
  ">

  <div class="
      mx-auto
      w-full
      max-w-[1700px]
    ">
    <AppShell>
      <Fragment slot="editor">
        <NoteEditor client:load />
      </Fragment>

      <Fragment slot="notes">
          <NotesList client:visible />
      </Fragment>

    </AppShell>
  </div>

</section>