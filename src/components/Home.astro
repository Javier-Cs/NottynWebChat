---
import '../styles/global.css'
import AppShell from "@/components/AppShell.astro";
import NoteEditor from "@/modules/NoteEditor";
import NotesList from "@/modules/NotesList";
---
---

<section
  class="
    flex
    flex-col
    items-center
    justify-center
    text-center
    h-full
    w-full
    px-6
    py-10
    bg-slate-200 dark:bg-zinc-800
  "
>

  <AppShell>
                
    <Fragment slot="editor">
        <NoteEditor client:load />
    </Fragment>

    <Fragment slot="notes">
        <NotesList client:visible />
    </Fragment>
                
  </AppShell>

</section>