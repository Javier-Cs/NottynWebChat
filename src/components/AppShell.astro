---
const { editor, notes } = Astro.props
---

<section
  class="
    grid
    grid-cols-1
    xl:grid-cols-[1fr_380px]
    gap-8
    items-start
    w-full
    bg-gray-100 dark:bg-zinc-800"
>
  <div class="min-w-0">
    <slot name="editor" />
  </div>

  <div class="min-w-0">
    <slot name="notes" />
  </div>
</section>